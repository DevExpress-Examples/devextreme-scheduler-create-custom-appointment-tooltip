@using ASP_NET_Core.Models
@model IEnumerable<Appointment>

<script>
    const employees = [{
        text: "John Heart",
        id: 1,
        color: "#56ca85",
    }, {
        text: "Sandra Johnson",
        id: 2,
        color: "#ff9747",
    }];

    function formatDate(date) {
        return `${date.getHours()}:${date.getMinutes()}`;
    }

    function listItemTemplate(itemData) {
        const result = $("<div>").addClass("tooltip");
        const marker = $("<div>").addClass("marker").appendTo(result);
        const content = $("<div>").appendTo(result);
        itemData.colorDef.done((color) => marker.css({ background: color }));
        $("<p>").text(itemData.text).appendTo(content);
        $("<p>").text(`${itemData.startDate} - ${itemData.endDate}`).appendTo(content);
        return result;
    }

    function onAppointmentTooltipShowing(e) {
        e.cancel = true;
        const list = $("#list").dxList("instance");
        list.option("dataSource", e.appointments.map((item) => ({
            text: item.appointmentData.text,
            colorDef: item.color,
            startDate: formatDate(item.appointmentData.startDate),
            endDate: formatDate(item.appointmentData.endDate),
        })));
    }
</script>

<div class="container">
    @(Html.DevExtreme().List()
        .ID("list")
        .Width("33%")
        .DataSource(new JS("[]"))
        .ItemTemplate(new JS("listItemTemplate"))
    )

    @(Html.DevExtreme().Scheduler()
        .ID("scheduler")
        .DataSource(Model)
        .TextExpr("Text")
        .StartDateExpr("StartDate")
        .EndDateExpr("EndDate")
        .CurrentView(SchedulerViewType.Week)
        .CurrentDate(new DateTime(2021, 6, 2))
        .FirstDayOfWeek(FirstDayOfWeek.Monday)
        .StartDayHour(15)
        .EndDayHour(20)
        .ShowAllDayPanel(false)
        .Width("66%")
        .Height(600)
        .Resources(res => {
            res.Add()
                .FieldExpr("EmployeeID")
                .AllowMultiple(false)
                .DataSource(new JS("employees"))
                .Label("Employee");
        })
        .OnAppointmentTooltipShowing("onAppointmentTooltipShowing")
    )
</div>
